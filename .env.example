# Optional for local dev only; Vite dev proxy target.
# If omitted, Vite proxies /api -> http://localhost:8000
VITE_API_URL=http://localhost:8000

# Used by Railway runtime (server.cjs), not exposed to browser.
BACKEND_INTERNAL_URL=http://fairplay-gamified-backend.railway.internal

# Optional: public URL of the click game app. Adds a Play Game button in sidebar.
VITE_GAME_URL=https://fairplay-gamified-game-production.up.railway.app
